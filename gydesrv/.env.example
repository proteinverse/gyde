# Optional PERSONAL installation only. Leave GYDE_COMPUTE_PROVIDER unset for Slivka.
# Never put TAMARIND_API_KEY in a frontend .env or a REACT_APP_* variable.
GYDE_COMPUTE_PROVIDER=tamarind
GYDE_HOST=127.0.0.1
GYDE_PORT=3030
GYDE_MOCK_USER=personal
# Use a MongoDB replica set; workspace updates require transactions.
GYDE_MONGO_CONNECTION=mongodb://127.0.0.1:27017/
GYDE_DB_NAME=gyde_personal
GYDE_STATIC_DIR=../gyde-frontend/build
TAMARIND_API_KEY_FILE=/absolute/path/to/private/tamarind-key
TAMARIND_ORIGIN=https://app.tamarind.bio
# TAMARIND_PROJECT_ID=proj_your_authorized_project
